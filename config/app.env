# Identity of the Pluma Android app (ci/patch.py).
PLUMA_PACKAGE=chat.pluma.app
PLUMA_APP_NAME=Pluma
# api_id and api_hash identify the app to the server (not secrets: every
# client carries them). Pluma: 10001 Android, 10002 iOS, 10003 Desktop, 10004 Web.
PLUMA_API_ID=10001
PLUMA_API_HASH=41ea38d2d0f65e642f3147e47c7e28b6
# ABIs of the APK: arm64-v8a covers the phones of the last decade; add
# x86_64 for an emulator.
PLUMA_ABIS=arm64-v8a
